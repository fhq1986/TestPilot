<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <!-- 审计盖章拦截器要在 SaveChanges 上验证，需要能脱离 Postgres 起一个内存库。
         版本对齐 EF Core 8.0 线（主体解析到 8.0.8）。 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AI.TestPlatform.Application\AI.TestPlatform.Application.csproj" />
    <ProjectReference Include="..\..\src\AI.TestPlatform.Api\AI.TestPlatform.Api.csproj" />
  </ItemGroup>

</Project>
