# 容器化交付的环境变量模板
#
#   cp .env.example .env
#   然后填入真实值（.env 已被 .gitignore 忽略，不要提交到仓库）

# ---------- 必填 ----------
# JWT 签名密钥，至少 32 字符。生成方式：openssl rand -base64 48
JWT_KEY=
# CI Webhook 令牌，调用 /api/webhooks/executions 时放在 X-Webhook-Token 头
WEBHOOK_TOKEN=
# 后端 ⇄ AIWorker 的服务间令牌（X-Worker-Token 头），aiworker 与 backend 必须一致；
# AIWorker 未配置它时会拒绝所有 /api/* 请求（fail closed）
WORKER_TOKEN=

# ---------- 数据库 ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_test
POSTGRES_PORT=5432

# ---------- 端口与跨域 ----------
# 前端对外端口；ALLOWED_ORIGINS 必须与浏览器实际访问的地址一致，否则会被 CORS 拦掉
WEB_PORT=8088
ALLOWED_ORIGINS=http://localhost:8088
# 后端直连端口（容器内是 8080）。CI 的 webhook 调用走这里：
#   curl -X POST "http://<主机>:8002/api/webhooks/executions?wait=true"
BACKEND_API_PORT=8002
# AIWorker 对外端口（容器内是 8000），一般只在排查 LLM 调用时直连
AIWORKER_PORT=8001

# ---------- LLM（AI 生成用例 / 元素定位 / 视觉语义说明） ----------
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash 

# ---------- SignalR 跨实例 backplane（多实例就绪） ----------
# backend 多副本（--scale backend=N）时 Hub 事件经 Redis 广播；默认用 compose 内的 redis。
# 置空（SIGNALR_REDIS= 后不填值且删除下行默认）需同时改 compose，一般不用动。
SIGNALR_REDIS=redis:6379

# ---------- 产物存储（MinIO，多实例就绪） ----------
# 执行截图/trace/富文本图片默认存 MinIO（多副本共享）。置 STORAGE_PROVIDER=local 退回本地卷。
# ⚠ 从 local 切到 minio 后历史产物不自动迁移，旧执行的截图/trace 链接会失效。
STORAGE_PROVIDER=minio
MINIO_ROOT_USER=minioadmin
# MinIO 控制台密码，至少 8 字符；控制台在 http://<主机>:9001（仅回环）
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=aitest-artifacts
MINIO_CONSOLE_PORT=9001

# ---------- JWT 可选 ----------
JWT_ISSUER=ai-test-platform
JWT_AUDIENCE=ai-test-platform

# ---------- 执行面独立进程（可选，默认不启动） ----------
# 默认 backend 一个进程同时是「控制面(API) + 执行面(worker)」。
# 需要把执行面拆出去（独立扩缩容 / 故障隔离 / 不把 API 一起重启）时显式开启：
#
#   docker compose --profile worker up -d backend-worker
#
# 它复用同一个镜像，只把 Execution__Role 切成 WorkerOnly（不映射任何 HTTP 端点），
# 并靠 SIGNALR_REDIS 把执行进度事件广播回 API 进程上的浏览器连接。
# 部署机只有 4 vCPU/3.7GB，多一份常驻 .NET 进程是实打实的开销，故默认关闭。
#
# 节点名：会写进 Execution.ClaimedBy 前缀与节点看板，必须与 API 进程不同。
WORKER_NODE_NAME=worker-1
